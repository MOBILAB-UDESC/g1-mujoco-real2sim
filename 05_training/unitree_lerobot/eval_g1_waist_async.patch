+    replan: str = "async"
+    # PyTorch CPU threads (0 = leave as is)
+    threads: int = 0
+    # waist yaw speed limit [rad/s], only used by policies that have the waist joint
+    waist_max_vel: float = 2.0
+
     rename_map: dict[str, str] = field(default_factory=dict)
 
